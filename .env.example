# === База данных PostgreSQL ===
POSTGRES_DB=kittygram
POSTGRES_USER=kittygram_user
# Придумайте свой надёжный пароль, не используйте значение из примера
POSTGRES_PASSWORD=your_strong_password

# Хост и порт базы данных.
# Внутри docker-compose это сервис "db";
# для локального запуска без Docker укажите localhost
DB_HOST=db
DB_PORT=5432

# === Django ===
# Сгенерируйте ключ командой:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-django-secret-key

# True — только для локальной разработки! В продакшене всегда False
DEBUG=False

# Список разрешённых хостов через запятую, без пробелов и схемы
ALLOWED_HOSTS=your-server-ip,127.0.0.1,localhost
